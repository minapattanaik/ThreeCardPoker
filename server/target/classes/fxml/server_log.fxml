<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="ServerLogController" styleClass="root">
    <top>
        <HBox alignment="CENTER" spacing="20" prefHeight="100">
            <padding><Insets top="10" right="10" bottom="10" left="10"/></padding>

            <VBox styleClass="subtitle-box" alignment="CENTER" prefWidth="350">
                <Label fx:id="clientCountLabel" text="CONNECTED CLIENTS: 0" styleClass="info-label"/>
                <Label fx:id="gameCountLabel" text="TOTAL GAMES: 0" styleClass="info-label"/>
            </VBox>

            <VBox spacing="10">
                <Button text="STOP SERVER" onAction="#onStopServer" styleClass="pixel-button"/>
                <Button text="CLEAR LOG" onAction="#onClearLog" styleClass="pixel-button"/>
            </VBox>
        </HBox>
    </top>

    <center>
        <VBox spacing="0">
            <padding><Insets top="0" right="20" bottom="20" left="20"/></padding>
            <Label text="SERVER LOG" styleClass="dealer-title" maxWidth="Infinity" alignment="CENTER"/>

            <ListView fx:id="logListView" styleClass="server-log-list"/>
        </VBox>
    </center>
</BorderPane>