<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane fx:id="root"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="EntryController"
            prefWidth="1100" prefHeight="650"
            styleClass="root">

    <top>
        <VBox alignment="CENTER">
            <padding>
                <Insets top="30" right="0" bottom="10" left="0"/>
            </padding>
            <Label text="THREE CARD POKER" styleClass="title-label"/>
        </VBox>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="25">

            <VBox alignment="CENTER">
                <padding>
                    <Insets top="0" right="0" bottom="20" left="0"/>
                </padding>
                <ImageView fx:id="heroImage"
                           fitWidth="180"
                           preserveRatio="true"
                           smooth="false" />
            </VBox>

            <StackPane styleClass="subtitle-box" maxWidth="750">
                <Label text="Please enter your port number &amp; IP to begin playing!"
                       styleClass="subtitle-label"/>
            </StackPane>

            <HBox alignment="CENTER" spacing="20">
                <padding>
                    <Insets top="15" right="0" bottom="0" left="0"/>
                </padding>

                <TextField fx:id="portField"
                           promptText="Port #:"
                           prefWidth="200"
                           styleClass="text-field"/>

                <TextField fx:id="ipField"
                           promptText="IP Address"
                           prefWidth="240"
                           styleClass="text-field"/>
            </HBox>

            <Button fx:id="connectButton"
                    text="CONNECT"
                    onAction="#onConnectClicked"
                    styleClass="pixel-button"/>

        </VBox>
    </center>

</BorderPane>